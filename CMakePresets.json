{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "default",
      "displayName": "RelWithDebInfo",
      "description": "Enables optimizations with debug information",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      },
      "inherits": ["base"]
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "No optimizations, enables debug information",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "inherits": ["base"]
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Optimized for performance, disables debug information",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "inherits": ["base"]
    },
    {
      "name": "windows-vcpkg",
      "displayName": "Windows + vcpkg",
      "description": "Use vcpkg toolchain on Windows (requires VCPKG_ROOT env var)",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      },
      "inherits": ["base"]
    },
    {
      "name": "iwyu",
      "displayName": "IWYU",
      "description": "Run include-what-you-use",
      "cacheVariables": {
        "ENABLE_IWYU": "ON"
      },
      "inherits": ["base"]
    },
    {
      "name": "ci",
      "cacheVariables": {
        "CI_BUILD": "ON"
      },
      "inherits": ["base"]
    }
  ]
}
