# Maintainer: kolbbond
# Prebuilt smg-* tools from the GitHub release tarball (scripts/package_linux.sh).
#
# Bump after a release: set pkgver, reset pkgrel=1, then take the checksum from the release's
# .sha256 asset (or run updpkgsums) and regenerate .SRCINFO:
#   curl -sL "https://github.com/kolbbond/simple-magnum-gui/releases/download/v$pkgver/smg-tools-$pkgver-linux-x86_64.tar.gz.sha256"
#   makepkg --printsrcinfo > .SRCINFO
pkgname=smg-tools-bin
pkgver=0.1.0
pkgrel=1
pkgdesc='simple-magnum-gui tools: file browser, results viewer, CSV plotter, disk usage, system monitor, HUD overlay (prebuilt)'
arch=('x86_64')
url='https://github.com/kolbbond/simple-magnum-gui'
license=('MIT')
# what the tarball leaves to the OS; Magnum, Corrade, ImGui and libsmg ship in lib/smg-tools
depends=('glibc' 'gcc-libs' 'libgl' 'sdl2' 'wayland')
provides=('smg-tools')
conflicts=('smg-tools')
# prebuilt: no sources for a -debug package
options=('!debug')
_tarname="smg-tools-$pkgver-linux-x86_64"
source=("$url/releases/download/v$pkgver/$_tarname.tar.gz"
        "LICENSE-$pkgver::https://raw.githubusercontent.com/kolbbond/simple-magnum-gui/v$pkgver/LICENSE")
# placeholders until v$pkgver is released: fill from the release .sha256 asset
sha256sums=('SKIP'
            'SKIP')

package() {
    install -dm755 "$pkgdir/usr"
    # bin/smg-* are relative links into lib/smg-tools/bin; cp -a keeps them
    cp -a "$srcdir/$_tarname/." "$pkgdir/usr/"
    install -Dm644 "$srcdir/LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
