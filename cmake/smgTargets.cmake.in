# Generated SMG imported target
# This file defines the smg::smg imported target

if(TARGET smg::smg)
    return()
endif()

# Compute the installation prefix relative to this file.
get_filename_component(_IMPORT_PREFIX "${CMAKE_CURRENT_LIST_FILE}" PATH)
get_filename_component(_IMPORT_PREFIX "${_IMPORT_PREFIX}" PATH)  # up from lib/cmake/smg
get_filename_component(_IMPORT_PREFIX "${_IMPORT_PREFIX}" PATH)  # up from lib/cmake
get_filename_component(_IMPORT_PREFIX "${_IMPORT_PREFIX}" PATH)  # up from lib

# Create imported target smg::smg
add_library(smg::smg SHARED IMPORTED)

# Build interface link libraries (SceneGraph is conditional)
set(_SMG_INTERFACE_LIBS "Corrade::Utility;Magnum::Sdl2Application;Magnum::Magnum;Magnum::GL;Magnum::MeshTools;Magnum::Primitives;Magnum::Shaders;Magnum::Trade;Magnum::Text;MagnumIntegration::ImGui")
if(@ENABLE_SCENEGRAPH@)
    list(APPEND _SMG_INTERFACE_LIBS "Magnum::SceneGraph")
endif()

set_target_properties(smg::smg PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${_IMPORT_PREFIX}/@CMAKE_INSTALL_INCLUDEDIR@"
    INTERFACE_LINK_LIBRARIES "${_SMG_INTERFACE_LIBS}"
    # PUBLIC defines/features the library was compiled with -- consumers MUST match
    # these (ScenePanel's layout depends on SMG_WITH_BLOOM etc.) or they get UB.
    INTERFACE_COMPILE_DEFINITIONS "@_SMG_EXPORT_DEFS@"
    INTERFACE_COMPILE_FEATURES "@_SMG_EXPORT_FEATURES@"
)

# Set library location (platform-specific)
if(WIN32)
    # Set configuration-specific locations for Windows multi-config builds
    # This ensures the correct DLL/lib is used for each build type
    set_target_properties(smg::smg PROPERTIES
        IMPORTED_IMPLIB "${_IMPORT_PREFIX}/@CMAKE_INSTALL_LIBDIR@/smg/smg.lib"
        # Default location (used when config doesn't match below)
        IMPORTED_LOCATION "${_IMPORT_PREFIX}/@CMAKE_INSTALL_BINDIR@/smg.dll"
        # Configuration-specific locations
        IMPORTED_LOCATION_DEBUG "${_IMPORT_PREFIX}/@CMAKE_INSTALL_BINDIR@/smg.dll"
        IMPORTED_LOCATION_RELEASE "${_IMPORT_PREFIX}/@CMAKE_INSTALL_BINDIR@/smg.dll"
        IMPORTED_LOCATION_RELWITHDEBINFO "${_IMPORT_PREFIX}/@CMAKE_INSTALL_BINDIR@/smg.dll"
        IMPORTED_LOCATION_MINSIZEREL "${_IMPORT_PREFIX}/@CMAKE_INSTALL_BINDIR@/smg.dll"
    )
    # Map any other configs to Release
    set_property(TARGET smg::smg PROPERTY MAP_IMPORTED_CONFIG_DEBUG Debug Release RelWithDebInfo "")
    set_property(TARGET smg::smg PROPERTY MAP_IMPORTED_CONFIG_RELEASE Release RelWithDebInfo Debug "")
    set_property(TARGET smg::smg PROPERTY MAP_IMPORTED_CONFIG_RELWITHDEBINFO RelWithDebInfo Release Debug "")
    set_property(TARGET smg::smg PROPERTY MAP_IMPORTED_CONFIG_MINSIZEREL MinSizeRel Release RelWithDebInfo "")
elseif(APPLE)
    set_target_properties(smg::smg PROPERTIES
        IMPORTED_LOCATION "${_IMPORT_PREFIX}/@CMAKE_INSTALL_LIBDIR@/smg/libsmg.dylib"
    )
else()
    set_target_properties(smg::smg PROPERTIES
        IMPORTED_LOCATION "${_IMPORT_PREFIX}/@CMAKE_INSTALL_LIBDIR@/smg/libsmg.so"
        IMPORTED_SONAME "libsmg.so"
    )
endif()

unset(_SMG_INTERFACE_LIBS)
