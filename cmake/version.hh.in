// Simple-Magnum-Gui version information.
// Generated by CMake from cmake/version.hh.in -- do not edit the generated copy.
#ifndef SMG_VERSION_HH
#define SMG_VERSION_HH

#define SMG_PROJECT_NAME "@PROJECT_NAME@"

// Numeric components -- integers, usable in preprocessor comparisons.
#define SMG_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define SMG_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define SMG_VERSION_PATCH @PROJECT_VERSION_PATCH@

// Combined, monotonically comparable: e.g. 0.1.0 -> 100, 1.2.3 -> 10203.
#define SMG_VERSION \
	(SMG_VERSION_MAJOR * 10000 + SMG_VERSION_MINOR * 100 + SMG_VERSION_PATCH)

// Human-readable, e.g. "0.1.0".
#define SMG_VERSION_STRING "@PROJECT_VERSION@"

// Compare against a (major, minor, patch) triple:
//   #if SMG_VERSION >= SMG_VERSION_CHECK(0, 2, 0)
#define SMG_VERSION_CHECK(major, minor, patch) \
	((major) * 10000 + (minor) * 100 + (patch))

#endif // SMG_VERSION_HH
